{
  "app-name": "DolphinConnect",
  "brand": {
    "display-name-fa": "دلفین کانکت",
    "display-name-en": "Dolphin Connect",
    "site": "https://support.dolphindev.ir",
    "support-phone": "021-44280505",
    "source-url": "https://github.com/kohandelramin/dolphin-connect-client"
  },
  "override": {
    "verification-method": "use-temporary-password",
    "temporary-password-length": "8",
    "allow-only-conn-window-open": "Y",
    "allow-remote-config-modification": "N",
    "enable-tunnel": "N",
    "enable-remote-restart": "N",
    "enable-terminal": "N",
    "direct-server": "N",
    "allow-auto-disconnect": "N",
    "enable-lan-discovery": "N",
    "allow-auto-update": "N",
    "enable-record-session": "N",
    "enable-block-input": "N",
    "enable-camera": "N",
    "enable-privacy-mode": "N",
    "allow-remote-cm-modification": "N",
    "allow-insecure-tls-fallback": "N"
  },
  "default": {
    "approve-mode": "password"
  },
  "local-override": {
    "enable-check-update": "N"
  },
  "local-default": {
    "lang": "fa"
  },
  "builtin": {
    "allow-deep-link-server-settings": "N",
    "allow-deep-link-password": "N",
    "disable-change-permanent-password": "Y",
    "hide-server-settings": "Y",
    "hide-security-settings": "Y",
    "hide-help-cards": "Y",
    "hide-stop-service": "Y"
  },
  "hard": {
    "disable-installation": "N",
    "disable-account": "Y",
    "disable-ab": "Y"
  },
  "variants": {
    "customer": {
      "hard": { "conn-type": "incoming" }
    },
    "technician": {
      "app-name": "DolphinConnectTech",
      "display-name-fa": "دلفین کانکت کارشناس",
      "display-name-en": "Dolphin Connect Technician",
      "hard": { "conn-type": "outgoing" },
      "local-override": {
        "keep-awake-during-outgoing-sessions": "Y",
        "enable-confirm-closing-tabs": "Y",
        "hide-recording-button": "Y"
      }
    }
  }
}
